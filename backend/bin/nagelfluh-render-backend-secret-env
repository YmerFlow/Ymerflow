#!/usr/bin/env python
"""Render the merged nagelfluh-backend-secret contents as a kubectl --from-env-file-compatible
KEY=VALUE stream, for prod/runall-production.sh's Step 6.

Usage: nagelfluh-render-backend-secret-env <path-to-config.env>

Two layers (Design decisions 2/3/5 of docs/plans/generic-backend-config-passthrough.md):

1. Generic base layer — every KEY=VALUE actually assigned in config.env itself, parsed directly
   from the file (via python-dotenv, already a transitive dependency through pydantic-settings) so
   this never picks up host/container environment noise the calling shell happens to have set.
   This is what lets a plugin author reach the backend pod by editing config.env alone — no core
   script change, ever.
2. A short, fixed set of script-computed overrides, read from THIS PROCESS's own environment
   (i.e. whatever the calling shell explicitly exported before invoking this script) and applied
   on top, replacing anything the same key had in the base layer. These are the only keys core
   deployment code is still allowed to know by name:
     - DATABASE_URL, REGISTRY_AUTH: assembled from Postgres/registry credentials, not literal
       config.env text.
     - MC_HOST_minio, MINIO_ROOT_PASSWORD: MinIO admin credentials with a default-fallback that
       differs from raw config.env text when unset.
     - REGISTRY_PROTOCOL/REGISTRY_CONFIG_JSON, STORAGE_PROTOCOL/STORAGE_CONFIG_JSON,
       CLUSTER_TYPE/CLUSTER_CONFIG_JSON: the bootstrap-ENRICHED versions from
       nagelfluh-bootstrap-provision (Step 3), which can differ from whatever raw value is still
       sitting in config.env. The calling shell only exports a pair together (or neither), so
       presence in os.environ already encodes the original "both or neither" guard.
     - SERVER_URL, BACKEND_BASE_URL, REGISTRY_PUBLIC_HOST: carry a `hostname -I`-derived default
       fallback when unset in config.env — same "computed, not raw text" reasoning.
     - REGISTRY_URL: derived from the resolved registry protocol's image-prefix (Step 5), not
       config.env text.
     - STORAGE_ENDPOINT, STORAGE_BUCKET_PREFIX: the in-cluster MinIO Service DNS address / bucket
       prefix production always uses, regardless of any STORAGE_ENDPOINT an operator may have set
       in config.env for the (unrelated) dev host-process case — must win unconditionally or a
       dev-oriented config.env value would leak into prod and break storage.

Everything else in config.env passes through completely opaque to this script and to every caller
of it — a plugin's config vars need never be enumerated here.

Prints KEY=VALUE lines to stdout (kubectl create secret --from-env-file= format); diagnostics to
stderr.
"""
import os
import sys

from dotenv import dotenv_values

OVERRIDE_KEYS = [
    "DATABASE_URL", "REGISTRY_AUTH", "MC_HOST_minio", "MINIO_ROOT_PASSWORD",
    "REGISTRY_PROTOCOL", "REGISTRY_CONFIG_JSON",
    "STORAGE_PROTOCOL", "STORAGE_CONFIG_JSON",
    "CLUSTER_TYPE", "CLUSTER_CONFIG_JSON",
    "SERVER_URL", "BACKEND_BASE_URL", "REGISTRY_PUBLIC_HOST", "REGISTRY_URL",
    "STORAGE_ENDPOINT", "STORAGE_BUCKET_PREFIX",
]


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} <path-to-config.env>", file=sys.stderr)
        sys.exit(1)

    config_env_path = sys.argv[1]

    merged = {k: v for k, v in dotenv_values(config_env_path).items() if v is not None}

    for key in OVERRIDE_KEYS:
        value = os.environ.get(key)
        if value is not None:
            merged[key] = value

    for key, value in merged.items():
        print(f"{key}={value}")


if __name__ == "__main__":
    main()
